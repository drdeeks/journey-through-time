# ===========================================
# Journey Through Time App - Environment Configuration
# ===========================================
# Version: 1.1.5
# Last Updated: 2026-01-15

# Blockchain Configuration
# -------------------------
# Your wallet's private key for deployment (NEVER commit the real .env file)
PRIVATE_KEY=your_wallet_private_key_here

# RPC endpoint for blockchain network
ETH_RPC_URL=https://testnet-rpc.monad.xyz  # Used by both Hardhat & Foundry

# Foundry keystore account label (see scripts/deploy_foundry.sh)
FOUNDRY_KEYSTORE=monad-deployer  # Name of the keystore file without extension

# API key for contract verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Frontend Configuration
# ----------------------
# Deployed smart contract address (set after deployment)
REACT_APP_CONTRACT_ADDRESS=your_deployed_contract_address_here

# Base, Arbitrum, and Monad contract addresses (comma-separated list)
REACT_APP_CHAIN_ADDRESSES=base:0x0000000000000000000000000000000000000000,arbitrum:0x0000000000000000000000000000000000000000,monad:0x0000000000000000000000000000000000000000

# Network chain ID (10143 for Monad testnet, 1337 for local)
REACT_APP_NETWORK_ID=10143

# RPC URL for frontend (defaults to Monad testnet)
REACT_APP_RPC_URL=https://rpc.testnet.monad.xyz

# Application environment (development, staging, production)
REACT_APP_ENV=development

# Farcaster Frame service URL
REACT_APP_FRAME_URL=https://your-frame-service.example.com/frame

# Security Configuration
# ----------------------
# Enable/disable debug logging (set to 'false' for production)
REACT_APP_DEBUG=true

# Enable gas reporting for testing
REPORT_GAS=true

# Development Configuration
# -------------------------
# Enable hot reloading
FAST_REFRESH=true

# Skip TypeScript type checking during development (not recommended)
# Note: v1.1.5 has 0 TypeScript errors with strict mode enabled
TSC_COMPILE_ON_ERROR=false

# Skip preflight checks (use if you have dependency conflicts)
SKIP_PREFLIGHT_CHECK=false

# Production Configuration
# ------------------------
# Set to 'true' to generate source maps in production
GENERATE_SOURCEMAP=false

# Set to 'true' to enable service worker caching
REACT_APP_ENABLE_SW=false

# Enable error reporting in production
REACT_APP_ENABLE_ERROR_REPORTING=true

# Enable performance monitoring in production
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# Enable analytics in production
REACT_APP_ENABLE_ANALYTICS=true

# Security Headers (for production deployment)
# -------------------------------------------
# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval'
CSP_STYLE_SRC='self' 'unsafe-inline'

# Testing Configuration
# ---------------------
# Run tests in CI mode (no watch mode)
CI=false

# Notes
# -----
# - Always use .env.local for local development (git-ignored)
# - Never commit .env files with real credentials
# - Use environment-specific files: .env.development, .env.production
# - All REACT_APP_* variables are embedded in the build
# - REACT_APP_FRAME_URL should point to the serverless frame service
# - Restart dev server after changing environment variables

# Example Deployment Values (Monad Testnet)
# -----------------------------------------
# PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
# REACT_APP_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
# ETH_RPC_URL=https://rpc.testnet.monad.xyz
# REACT_APP_NETWORK_ID=10143
