# ============================================
# Journey Through Time - Letter Generator Backend
# Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# Server Configuration
NODE_ENV=development
PORT=3001

# Blockchain Configuration (Monad Mainnet - Chain 143)
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_CHAIN_ID=143

# For Monad Testnet (Chain 10143), use:
# MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# MONAD_CHAIN_ID=10143

# Contract Configuration
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Backend Wallet (for signing transactions)
PRIVATE_KEY=your_wallet_private_key_here

# Matthew's Special Account Address (Matrix)
MATRIX_ADDRESS=0xMatthewsWalletAddressHere

# Optional API Key for rate limiting
API_KEY=optional_api_key_for_rate_limiting

# Content Configuration
MAX_CONTENT_LENGTH=5000

# Logging
LOG_LEVEL=info  # debug, info, warn, error

# Feature Flags (all enabled by default)
ENABLE_X402_PAYMENTS=true
ENABLE_ERC20_PAYMENTS=true
ENABLE_AUTO_GENERATION=true
ENABLE_CONTENT_TRUNCATION=true
RATE_LIMIT_ENABLED=false

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Blockchain Polling (ms)
BLOCKCHAIN_POLLING_INTERVAL=15000

# Gas Price Multiplier (1.0 = use estimated price)
GAS_PRICE_MULTIPLIER=1.0

# ============================================
# Production Configuration Example
# ============================================
# NODE_ENV=production
# PORT=8080
# MONAD_RPC_URL=https://rpc.monad.xyz
# MONAD_CHAIN_ID=143
# CONTRACT_ADDRESS=0x1234567890abcdef1234567890abcdef12345678
# PRIVATE_KEY=0x_actual_private_key_without_0x_prefix
# MATRIX_ADDRESS=0x1234567890abcdef1234567890abcdef12345678
